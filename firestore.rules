rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'mubarakzhikirullah@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) && data.id == request.auth.uid &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 128 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'service', 'status']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'userEmail', 'company', 'phone', 'service', 'budget', 'timeline', 'details', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 256 &&
        (!('company' in data) || (data.company is string && data.company.size() <= 128)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
        data.service is string && data.service.size() > 0 && data.service.size() <= 128 &&
        (!('budget' in data) || (data.budget is string && data.budget.size() <= 64)) &&
        (!('timeline' in data) || (data.timeline is string && data.timeline.size() <= 64)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 4000)) &&
        (data.status == 'submitted' || data.status == 'under_review' || data.status == 'contacted');
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid &&
        isValidUser(incoming());
      allow update: if isVerified() && isValidId(userId) && isOwner(userId) &&
        isValidUser(incoming()) && incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // INQUIRIES COLLECTION
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(inquiryId) && inquiryId == incoming().id &&
        isValidInquiry(incoming()) && incoming().status == 'submitted' && incoming().userId == request.auth.uid;
      allow update: if isVerified() && isValidId(inquiryId) && isValidInquiry(incoming()) &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isOwner(existing().userId) && incoming().userId == existing().userId &&
           existing().status == 'submitted' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['details', 'budget', 'timeline', 'phone', 'company', 'updatedAt']))
        );
      allow delete: if isAdmin() || (isOwner(resource.data.userId) && resource.data.status == 'submitted');
    }

    // ADMINS COLLECTION
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
